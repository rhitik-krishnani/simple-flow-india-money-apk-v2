{
  "name": "indian-money-code",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "eslint .",
    "cap:sync": "npx cap sync android",
    "cap:copy": "npx cap copy android",
    "android:build": "npm run build:web && npx cap sync android",
    "android:apk": "npm run android:build && cd android && ./gradlew assembleDebug",
    "test": "tsx tests/ruleEngine.test.ts && tsx tests/server.test.ts",
    "smoke": "node tests/smoke.mjs",
    "build:web": "vite build"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/device": "^8.0.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@google/genai": "^1.30.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/express": "^5.0.6",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "esbuild": "^0.28.0",
    "express": "^5.2.1",
    "firebase": "^12.6.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.555.0",
    "motion": "^12.38.0",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^4.0.379",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-is": "^19.3.0",
    "recharts": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.1",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.2.1",
    "jsdom": "^30.1.2",
    "typescript": "~5.8.2",
    "vite": "^8.0.10"
  }
