# ---------- Backend (server.ts) ----------
# Required for AI features
GEMINI_API_KEY=
# Firebase project that signs your users in (read from firebase-applet-config.json if omitted)
FIREBASE_PROJECT_ID=
# Extra origins allowed to call the API (comma separated). https://localhost and capacitor://localhost are always allowed.
ALLOWED_ORIGINS=
# Per-user limits for AI calls (defaults shown)
AI_PER_MINUTE=10
AI_PER_DAY=100
# Optional: emails allowed to use the internal Veo video studio. Leave empty to switch the video routes off.
ADMIN_EMAILS=
# Hosts like Cloud Run / Render set PORT themselves
# PORT=8080

# ---------- App build (Vite) ----------
# Public address of the deployed backend. REQUIRED when building the Android app, e.g. https://api.yourdomain.com
VITE_API_BASE_URL=

# ---------- DeepSeek AI (used by the app directly, no backend needed) ----------
# Local builds: put your key in a file named .env (never commit it). GitHub builds: add a repo secret DEEPSEEK_API_KEY.
VITE_DEEPSEEK_API_KEY=
# Optional: a proxy that holds the key instead of the app (e.g. Cloudflare Worker). Leave empty for the POC.
VITE_AI_PROXY_URL=
